# ==============================================================================
# ScriptFlow / ScriptCraft — Environment Configuration Example
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database & Authentication
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/script_dashboard?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Google Gemini Generative AI Engine (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1. YouTube Data API v3
# Instructions:
#  1. Go to Google Cloud Console (https://console.cloud.google.com)
#  2. Enable "YouTube Data API v3"
#  3. Create an API Key under Credentials
#  4. Paste key below. Used for real Shorts statistics, views, duration, & channels.
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# 2. Meta Graph API (Instagram Business & Meta Ads Library)
# Instructions:
#  1. Register at Meta for Developers (https://developers.facebook.com)
#  2. Create a Business App and add Instagram Graph API
#  3. Connect an Instagram Professional account to a Facebook Page
#  4. Generate User Access Token with: instagram_basic, instagram_manage_insights
# ------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. Google Trends
# Instructions:
#  - Automated live regional RSS trending feed is active with zero configuration.
#  - If your enterprise is enrolled in the Google Trends API program, set token below:
# ------------------------------------------------------------------------------
GOOGLE_TRENDS_API_TOKEN=

# ------------------------------------------------------------------------------
# 4. Tavily AI Search (Real-time Industry News & Announcements)
# Instructions:
#  1. Sign up at https://tavily.com (free monthly query tier available)
#  2. Copy API key and paste below
#  - Google News real-time RSS search is always active as a zero-cost fallback.
# ------------------------------------------------------------------------------
TAVILY_API_KEY=
